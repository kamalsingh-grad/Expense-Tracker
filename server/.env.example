# Port the API + static UI are served on
PORT=5000
# Production: full MongoDB connection string (e.g. MongoDB Atlas). Omit to run with an ephemeral in-memory MongoDB seeded with demo data.
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/expenseflow
# Seed demo data on boot when DB is empty (default true)
SEED_ON_START=true
# NODE_ENV=production
